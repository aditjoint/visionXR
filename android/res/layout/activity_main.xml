<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0f19"
    android:padding="8dp">

    <!-- Top Sovereign Security & Air-Gap Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1e293b"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_security_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔒 AIR-GAPPED • ZERO NETWORK PROTOCOL • LOCAL EDGE ONLY"
            android:textColor="#06b6d4"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tamper_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VAULT: 20/20 SAFE"
            android:textColor="#10b981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Node Hardware Identifier -->
    <TextView
        android:id="@+id/tv_hwid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NODE: VXR-MOB-NODE-LOCK"
        android:textColor="#94a3b8"
        android:textSize="10sp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- Dual Camera Viewports (Split Screen / Picture-in-Picture) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <!-- Sensor #1: Rear Lens Surface -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000"
            android:layout_marginBottom="4dp">

            <SurfaceView
                android:id="@+id/surface_back_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_margin="6dp"
                android:text="SENSOR #1 • REAR PERIMETER LENS"
                android:textColor="#10b981"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#aa000000"
                android:padding="4dp" />
        </FrameLayout>

        <!-- Sensor #2: Front Lens Surface -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#000000">

            <SurfaceView
                android:id="@+id/surface_front_camera"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|left"
                android:layout_margin="6dp"
                android:text="SENSOR #2 • FRONT INWARD FACIAL LENS"
                android:textColor="#06b6d4"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#aa000000"
                android:padding="4dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Controls & Sandboxed Evidence Viewer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp">

        <Button
            android:id="@+id/btn_trigger_evidence"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📸 CAPTURE DUAL EVIDENCE"
            android:textColor="#ffffff"
            android:background="#0284c7"
            android:textSize="11sp"
            android:layout_marginRight="4dp" />

        <Button
            android:id="@+id/btn_view_evidence"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📂 LOCAL SANDBOX GALLERY"
            android:textColor="#ffffff"
            android:background="#334155"
            android:textSize="11sp"
            android:layout_marginLeft="4dp" />
    </LinearLayout>

    <!-- Discrepancy Alert Status Banner -->
    <TextView
        android:id="@+id/tv_alert_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✓ Dual sensors synchronized. Storage isolated in local app sandbox."
        android:textColor="#cbd5e1"
        android:textSize="10sp"
        android:paddingTop="4dp" />

</LinearLayout>
